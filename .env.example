# Copy to .env (git-ignored) or export before `dotnet run`. Never commit real values.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5202
# Development-only password for the invented demo users analyst@example.com and credit@example.com.
# Leave empty to have the Auth block generate one and log it once at start-up.
DemoUsers__Password=
# Optional: path to the lending criteria file (default: criteria.json next to the API). Edits reload without a restart.
CriteriaFile=
